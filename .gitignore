# ============================================================================
# Secrets, credentials, signing material
# NEVER commit any of these. App Store Connect API keys, provisioning
# profiles, certificates, and entitlements overrides live here too.
# ============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
Secrets.plist
secrets.xcconfig
*.xcconfig.local
AuthKey_*.p8

# Supabase / Firebase / other BaaS client configs that sometimes contain
# embedded keys. Un-ignore individually if you decide a specific file is safe.
# GoogleService-Info.plist
# Supabase.plist

